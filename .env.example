# Comma-separated exact allowlists. Changes require restarting the server.
HOMELAB_ALLOWED_SERVICES=ssh.service,nginx.service,docker.service
HOMELAB_ALLOWED_LOGS=/var/log/syslog,/var/log/auth.log
HOMELAB_ALLOWED_DISKS=/,/home
HOMELAB_COMMAND_TIMEOUT_SECONDS=5
HOMELAB_MAX_OUTPUT_BYTES=16384
HOMELAB_MAX_LOG_LINES=200

# Optional incident evidence and analysis settings.
HOMELAB_AUDIT_LOG=/var/lib/homelab-mcp/audit.jsonl
HOMELAB_DISK_THRESHOLD_PERCENT=85
HOMELAB_DU_MAX_OUTPUT_BYTES=16384
HOMELAB_BACKUP_MAX_AGE_HOURS=24
HOMELAB_BACKUP_MARKERS=/var/lib/backups/latest
HOMELAB_CONFIG_FILES=/etc/ssh/sshd_config
HOMELAB_CONFIG_MANIFEST=/etc/homelab-mcp/config-manifest.json
# Trusted, read-only JSON: {"last_deploy":"...","before":{},"after":{}} (max 64 KiB).
HOMELAB_DEPLOYMENT_MANIFEST=/etc/homelab-mcp/deployment-manifest.json
HOMELAB_WATCH_PACKAGES=openssl
HOMELAB_ADVISORY_DB=/etc/homelab-mcp/advisories.json
